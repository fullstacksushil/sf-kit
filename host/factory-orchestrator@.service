[Unit]
Description=Software factory orchestrator for %i (Inngest functions + GitHub webhooks)
After=docker.service network-online.target
Requires=docker.service

[Service]
# init-host.sh replaces __USER__ with a user in the docker group.
User=__USER__
WorkingDirectory=/opt/factory/orchestrator
# The shared file loads first. A value in the factory file wins.
EnvironmentFile=/etc/factory/common.env
EnvironmentFile=/etc/factory/factories/%i.env
# FACTORY_NAME is on the command line, so no env file can change it.
ExecStart=/usr/bin/env FACTORY_NAME=%i npx tsx src/server.ts
# Register this factory with Inngest. No "-" prefix: a failed sync fails the unit.
# curl retries a refused connection (the app is not listening yet) and HTTP 5xx (Inngest is not up yet), up to 60 seconds.
# check: ${PORT} expansion in Exec lines is from systemd.service(5) "Command lines". curl flags are from curl(1), not run here.
ExecStartPost=/usr/bin/env curl -f -sS -X PUT --retry 60 --retry-delay 1 --retry-max-time 60 --retry-connrefused http://127.0.0.1:${PORT}/api/inngest
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
