[Unit]
Description=Software factory orchestrator (Inngest functions + GitHub webhooks)
After=docker.service network-online.target
Requires=docker.service

[Service]
# init-host.sh replaces __USER__ with a user in the docker group.
User=__USER__
WorkingDirectory=/opt/factory/orchestrator
EnvironmentFile=/etc/factory/orchestrator.env
ExecStart=/usr/bin/env npx tsx src/server.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
